{
  "description": "Blocks a Claude git push until the pre-push skill has reviewed that exact commit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/require-review-before-push.sh\""
          }
        ]
      }
    ]
  }
}
